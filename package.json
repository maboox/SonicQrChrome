{
  "name": "sonicqr-chrome",
  "version": "0.4.0",
  "private": true,
  "description": "Local, bilingual text-in-voice Chrome extension",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.cjs",
    "test:ui": "node tests/ui.cjs",
    "check": "npm run build && npm run validate && npm test && npm run test:ui && npm run test:recording && npm run test:browser",
    "test:recording": "node tests/recording-paths.cjs",
    "validate": "node scripts/validate.cjs",
    "package": "npm run build && npm run validate && node scripts/package.cjs",
    "store:assets": "node scripts/store-assets.cjs",
    "brand:assets": "node scripts/brand.cjs"
  },
  "dependencies": {
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "@playwright/test": "1.63.0",
    "lucide": "1.61.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
